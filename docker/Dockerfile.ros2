FROM ros:humble-ros-base

# Matches the host UID/GID docker-compose.yml runs the container as (its
# `user:` field), mirroring docker/Dockerfile.bench.
ARG DEV_UID=1000
ARG DEV_GID=1000

WORKDIR /workspace

# ros:humble-ros-base doesn't include the stdlib venv module by default.
RUN apt-get update \
    && apt-get install --no-install-recommends -y python3-venv \
    && rm -rf /var/lib/apt/lists/*

# rclpy and the rest of the ROS 2 Python stack live in the system site-packages
# installed by the base image's apt packages, not in any wheel we could `uv
# sync` in isolation. A `--system-site-packages` venv keeps that stack visible
# while still giving h2r's own dependencies (installed via pip below) an
# isolated, writable install location — so this deliberately uses pip instead
# of uv, unlike every other Docker image in this repo.
ENV VIRTUAL_ENV=/workspace/.venv-ros2
RUN python3 -m venv --system-site-packages ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# h2r's runtime dependencies plus psutil for the resource sampler, installed by hand
# rather than via `pip install -e .`: this image's Python is whatever ros:humble-ros-base
# ships (3.10, to match rclpy's compiled extension modules), which is older than this
# project's `requires-python = ">=3.11"` — an editable install would fail that check.
RUN pip install --no-cache-dir "h2>=4.1" "protobuf>=4.25" "pyyaml>=6.0" "psutil>=5.9"

COPY . .
# Expose `src/h2r` on the path without going through setuptools metadata (see above).
ENV PYTHONPATH=/workspace/src:/workspace

RUN chown -R ${DEV_UID}:${DEV_GID} ${VIRTUAL_ENV}

CMD ["bash"]
